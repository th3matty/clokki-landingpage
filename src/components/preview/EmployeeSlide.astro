---
import AppChrome from './AppChrome.astro'

/**
 * Mirrors the real employee dashboard (EmployeeView.vue): welcome header with
 * no avatar, then TimeEntryForm, then QuickStats row 1, then the recent
 * entries list. Hours print with a dot, as fmtH/toFixed(2) does in the app.
 */
const entries = [
  { date: 'Montag, 28. Sep', slots: ['09:00 - 17:30 (30min Pause)'], total: '8.00h', over: null },
  { date: 'Freitag, 25. Sep', slots: ['08:30 - 17:00 (45min Pause)'], total: '7.75h', over: null },
  {
    date: 'Donnerstag, 24. Sep',
    slots: ['09:00 - 13:00', '14:00 - 18:30'],
    total: '8.50h',
    over: '+0.50h',
  },
]

// Mon–Sun actual hours for the week bars; the dashed line is the 8h target.
const week = [
  { day: 'M', hours: 8.0 },
  { day: 'D', hours: 7.75 },
  { day: 'M', hours: 8.5 },
  { day: 'D', hours: 7.0 },
  { day: 'F', hours: 0 },
  { day: 'S', hours: 0 },
  { day: 'S', hours: 0 },
]
const TARGET = 8
const BAR_H = 44
---

<div class="bg-gray-50 dark:bg-gray-900">
  <AppChrome role="employee" />

  <div class="p-4 sm:p-5 space-y-4">
    <!-- Welcome header — no avatar in the real app -->
    <div>
      <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100">
        Willkommen zurück, Max Mustermann!
      </h3>
      <p class="mt-0.5 text-[11px] sm:text-xs text-gray-600 dark:text-gray-400">
        Zeit erfassen, Anträge stellen und deinen Saldo im Blick behalten.
      </p>
    </div>

    <!-- TimeEntryForm -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h4 class="text-base font-semibold text-gray-900 dark:text-gray-100">Zeiteintrag</h4>
          <p class="text-[11px] text-gray-600 dark:text-gray-400 mt-0.5">
            Dienstag, 29. September 2026
          </p>
        </div>
        <div class="flex items-center gap-1.5 flex-shrink-0">
          <span class="text-gray-400 dark:text-gray-500" aria-hidden="true">
            <svg
              class="w-3.5 h-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M15 19l-7-7 7-7"></path></svg
            >
          </span>
          <span
            class="flex items-center gap-1.5 px-2 py-1 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-[11px] text-gray-900 dark:text-gray-100"
          >
            29.09.2026
            <svg
              class="w-3 h-3 text-gray-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M16 3v4M8 3v4M3 11h18"></path>
            </svg>
          </span>
          <span class="text-gray-400 dark:text-gray-500" aria-hidden="true">
            <svg
              class="w-3.5 h-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M9 5l7 7-7 7"></path></svg
            >
          </span>
        </div>
      </div>

      <p class="mt-3 mb-2 text-[11px] font-medium text-gray-700 dark:text-gray-300">Arbeitszeit</p>

      <!-- One time slot, four fields in chronological order -->
      <div
        class="rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 p-3"
      >
        <div class="flex items-start gap-2.5">
          <span
            class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-[11px] font-medium text-blue-700 dark:text-blue-300"
            >1</span
          >
          <div class="flex-1 min-w-0 grid grid-cols-2 md:grid-cols-4 gap-2">
            {
              [
                { label: 'Startzeit', value: '09:00' },
                { label: 'Pausenbeginn', value: '12:00' },
                { label: 'Pausenende', value: '13:00' },
                { label: 'Endzeit', value: '17:00' },
              ].map((field) => (
                <div class="space-y-0.5 min-w-0">
                  <span class="block text-[9px] font-medium text-gray-500 dark:text-gray-400">
                    {field.label}
                  </span>
                  <span class="flex items-center justify-between gap-1 px-2 py-1 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700">
                    <span class="font-mono text-[11px] text-gray-900 dark:text-gray-100">
                      {field.value}
                    </span>
                    <svg
                      class="w-3 h-3 text-gray-400 flex-shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 8v4l3 2" />
                    </svg>
                  </span>
                </div>
              ))
            }
          </div>
          <div class="flex-shrink-0 text-right">
            <p class="text-sm font-semibold text-gray-900 dark:text-gray-100">7.00h</p>
            <p class="text-[10px] text-gray-500 dark:text-gray-400">-60m</p>
          </div>
        </div>
      </div>

      <span
        class="mt-2.5 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20"
      >
        <svg
          class="w-3 h-3"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path d="M12 4v16m8-8H4"></path></svg
        >
        Zeitblock hinzufügen
      </span>

      <!-- Total -->
      <div class="mt-3 rounded-lg bg-gray-50 dark:bg-gray-700 p-3">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-medium text-gray-700 dark:text-gray-300"
            >Gesamte Arbeitszeit:</span
          >
          <span class="text-lg font-bold text-blue-600 dark:text-blue-400">7.00h</span>
        </div>
        <p class="text-[10px] text-gray-500 dark:text-gray-400 mt-0.5">1 Zeitblock (60min Pause)</p>
      </div>

      <div class="mt-3 flex justify-end">
        <span
          class="px-4 py-1.5 rounded-lg bg-blue-600 text-white text-[11px] font-medium shadow-sm"
          >Eintrag speichern</span
        >
      </div>
    </div>

    <!-- QuickStats row 1 — the three KPI cards, each with its real chart -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <!-- Stunden heute: donut -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-3.5">
        <div class="flex items-center gap-2.5 mb-2">
          <span
            class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/20 flex items-center justify-center flex-shrink-0"
          >
            <svg
              class="w-4 h-4 text-blue-600 dark:text-blue-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 8v4l3 2"></path>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="text-[10px] font-medium text-gray-500 dark:text-gray-400">Stunden heute</p>
            <p class="flex items-baseline gap-1">
              <span class="text-lg font-semibold tabular-nums text-gray-900 dark:text-gray-100"
                >7.00h</span
              >
              <span class="text-[10px] tabular-nums text-gray-400 dark:text-gray-500">/ 8.00h</span>
            </p>
          </div>
        </div>
        <svg viewBox="0 0 160 76" class="w-full h-auto" role="img" aria-label="88 % des Tagesziels">
          <circle
            cx="80"
            cy="38"
            r="27"
            fill="none"
            class="stroke-gray-200 dark:stroke-gray-700"
            stroke-width="9"></circle>
          <circle
            cx="80"
            cy="38"
            r="27"
            fill="none"
            stroke="#2563eb"
            stroke-width="9"
            stroke-linecap="round"
            stroke-dasharray="149 170"
            transform="rotate(-90 80 38)"></circle>
          <text
            x="80"
            y="43"
            text-anchor="middle"
            class="fill-gray-900 dark:fill-gray-100"
            font-size="16"
            font-weight="600">88%</text
          >
        </svg>
      </div>

      <!-- Diese Woche: weekday bars with a dashed target line -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-3.5">
        <div class="flex items-center gap-2.5 mb-2">
          <span
            class="w-8 h-8 rounded-lg bg-green-100 dark:bg-green-900/20 flex items-center justify-center flex-shrink-0"
          >
            <svg
              class="w-4 h-4 text-green-600 dark:text-green-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M16 3v4M8 3v4M3 11h18"></path>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="text-[10px] font-medium text-gray-500 dark:text-gray-400">Diese Woche</p>
            <p class="flex items-baseline gap-1">
              <span class="text-lg font-semibold tabular-nums text-gray-900 dark:text-gray-100"
                >31.25h</span
              >
              <span class="text-[10px] tabular-nums text-gray-400 dark:text-gray-500">/ 40.00h</span
              >
            </p>
          </div>
        </div>
        <svg viewBox="0 0 160 66" class="w-full h-auto" role="img" aria-label="Stunden je Wochentag">
          {
            week.map((d, i) => {
              const h = (d.hours / 10) * BAR_H
              return (
                <rect
                  x={8 + i * 21}
                  y={52 - h}
                  width="14"
                  height={Math.max(h, 1.5)}
                  rx="3"
                  fill={
                    ['#3b82f6', '#0ea5e9', '#06b6d4', '#14b8a6', '#10b981', '#65a30d', '#94a3b8'][i]
                  }
                />
              )
            })
          }
          <line
            x1="6"
            y1={52 - (TARGET / 10) * BAR_H}
            x2="154"
            y2={52 - (TARGET / 10) * BAR_H}
            class="stroke-gray-400 dark:stroke-gray-500"
            stroke-width="1"
            stroke-dasharray="2 3"></line>
          {
            week.map((d, i) => (
              <text
                x={15 + i * 21}
                y="63"
                text-anchor="middle"
                class="fill-gray-400 dark:fill-gray-500"
                font-size="8"
              >
                {d.day}
              </text>
            ))
          }
        </svg>
        <p
          class="mt-0.5 flex items-center justify-end gap-1 text-[9px] tabular-nums text-gray-400 dark:text-gray-500"
        >
          <span class="inline-block w-3 border-t border-dashed border-current"></span>Ziel 8h
        </p>
      </div>

      <!-- Monatsstunden: cumulative area against the ideal pace -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-3.5">
        <div class="flex items-center gap-2.5 mb-2">
          <span
            class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/20 flex items-center justify-center flex-shrink-0"
          >
            <svg
              class="w-4 h-4 text-purple-600 dark:text-purple-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="text-[10px] font-medium text-gray-500 dark:text-gray-400">Monatsstunden</p>
            <p class="flex items-baseline gap-1">
              <span class="text-lg font-semibold tabular-nums text-gray-900 dark:text-gray-100"
                >152.50h</span
              >
              <span class="text-[10px] tabular-nums text-gray-400 dark:text-gray-500"
                >/ 160.00h</span
              >
            </p>
          </div>
        </div>
        <svg viewBox="0 0 160 76" class="w-full h-auto" role="img" aria-label="Kumulierte Monatsstunden gegen Sollverlauf">
          {
            [16, 34, 52].map((y) => (
              <line
                x1="8"
                y1={y}
                x2="154"
                y2={y}
                class="stroke-gray-200 dark:stroke-gray-700"
                stroke-width="1"
              />
            ))
          }
          <path
            d="M8 60 L154 12"
            fill="none"
            class="stroke-gray-400 dark:stroke-gray-500"
            stroke-width="1.5"
            stroke-dasharray="3 3"></path>
          <path
            d="M8 60 L37 49 L66 40 L95 30 L124 23 L154 17 L154 60 Z"
            fill="#16a34a"
            opacity="0.15"></path>
          <path
            d="M8 60 L37 49 L66 40 L95 30 L124 23 L154 17"
            fill="none"
            stroke="#2563eb"
            stroke-width="2"></path>
        </svg>
      </div>
    </div>

    <!-- Aktuelle Zeiteinträge -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow">
      <div
        class="px-4 py-2.5 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between"
      >
        <h4 class="text-sm font-medium text-gray-900 dark:text-gray-100">Aktuelle Zeiteinträge</h4>
        <div class="flex items-center gap-1 text-[11px] text-gray-600 dark:text-gray-400">
          <svg
            class="w-3 h-3"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"><path d="M15 19l-7-7 7-7"></path></svg
          >
          <span class="min-w-[74px] text-center font-medium">September 2026</span>
          <svg
            class="w-3 h-3 text-gray-300 dark:text-gray-600"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg
          >
        </div>
      </div>
      <div class="p-2.5 space-y-2">
        {
          entries.map((entry) => (
            <div class="flex items-center justify-between p-2.5 bg-gray-50 dark:bg-gray-700 rounded-lg">
              <div class="flex items-center gap-3 min-w-0">
                <span class="w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg
                    class="w-4 h-4 text-blue-600 dark:text-blue-400"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 8v4l3 2" />
                  </svg>
                </span>
                <div class="min-w-0">
                  <p class="text-[11px] font-medium text-gray-900 dark:text-gray-100 truncate">
                    {entry.date}
                  </p>
                  <ul class="text-[10px] text-gray-500 dark:text-gray-400 space-y-0.5 mt-0.5">
                    {entry.slots.map((slot) => (
                      <li>{slot}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="text-right flex-shrink-0 ml-3">
                <p class="text-sm font-semibold text-gray-900 dark:text-gray-100">{entry.total}</p>
                <p class="text-[10px]">
                  {entry.over ? (
                    <span class="text-green-600 dark:text-green-400">{entry.over} ÜT</span>
                  ) : (
                    <span class="text-gray-500 dark:text-gray-400">Gesamtstunden</span>
                  )}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
