---
/**
 * The app's own top navigation, as Navigation.vue renders it — not a browser
 * window. Which links appear depends on the role: Teamübersicht and
 * Deckungsprüfung are admin-only, Urlaubskalender is employee-only.
 */
interface Props {
  role?: 'employee' | 'admin'
}
const { role = 'employee' } = Astro.props

const links =
  role === 'admin'
    ? [
        { label: 'Teamübersicht', active: true },
        { label: 'Team', caret: true },
        { label: 'Deckungsprüfung' },
        { label: 'Einstellungen' },
      ]
    : [
        { label: 'Dashboard', active: true },
        { label: 'Urlaubskalender' },
        { label: 'Einstellungen' },
      ]
---

<div
  class="flex items-center gap-3 px-4 py-2.5 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800"
>
  <!-- Logo -->
  <div class="flex items-center gap-1.5 flex-shrink-0">
    <svg
      class="w-4 h-4 text-blue-600 dark:text-blue-400"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7v5l3 2"></path>
    </svg>
    <span class="text-xs font-semibold text-gray-900 dark:text-gray-100">Clokki</span>
  </div>

  <!-- Burger below md, exactly as Navigation.vue swaps the links out -->
  <svg
    class="md:hidden w-4 h-4 text-gray-400 dark:text-gray-500"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M4 7h16M4 12h16M4 17h16"></path>
  </svg>

  <!-- Links -->
  <nav class="hidden md:flex items-center gap-3 min-w-0 overflow-hidden">
    {
      links.map((link) => (
        <span
          class:list={[
            'flex items-center gap-0.5 text-[10px] whitespace-nowrap',
            link.active
              ? 'text-blue-600 dark:text-blue-400 font-medium'
              : 'text-gray-500 dark:text-gray-400',
          ]}
        >
          {link.label}
          {link.caret && (
            <svg
              class="w-2.5 h-2.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6" />
            </svg>
          )}
        </span>
      ))
    }
  </nav>

  <!-- Bell + profile -->
  <div class="ml-auto flex items-center gap-2 flex-shrink-0 text-gray-400 dark:text-gray-500">
    <span class="relative">
      <svg
        class="w-3.5 h-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
        <path d="M13.73 21a2 2 0 01-3.46 0"></path>
      </svg>
      <span
        class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 rounded-full bg-orange-500"
        aria-hidden="true"></span>
    </span>
    <svg
      class="w-4 h-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <circle cx="12" cy="10" r="3"></circle>
      <path d="M6.2 18.6a6 6 0 0111.6 0"></path>
    </svg>
  </div>
</div>
