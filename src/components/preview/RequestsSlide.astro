---
/**
 * Mirrors RequestsManagementModal.vue. In the app this is a modal over the
 * admin dashboard, not a page of its own — so the slide dims a backdrop and
 * floats the panel on it. Filter chips, the Feld/Aktuell/Angefragt change
 * table, the net change, the reason and the pagination all come from the
 * real component.
 */
const filters = [
  { label: 'Alle Anfragen', count: 28, active: true },
  { label: 'Ausstehend', count: 2 },
  { label: 'Genehmigt', count: 24 },
  { label: 'Abgelehnt', count: 1 },
  { label: 'Storniert', count: 1 },
  { label: 'Arbeitszeit', count: 11 },
]
---

<div class="bg-gray-100 dark:bg-gray-900">
  <!-- Dimmed backdrop: the admin dashboard is still behind the modal -->
  <div class="bg-gray-900/50 dark:bg-black/60 p-4 sm:p-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl overflow-hidden">
      <!-- Modal header -->
      <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-gray-100">
              Anfragen-Verwaltung
            </h3>
            <p class="text-[11px] text-gray-600 dark:text-gray-400 mt-0.5">
              Verwalten Sie alle ausstehenden und bearbeiteten Anfragen in Ihrem Team
            </p>
          </div>
          <svg
            class="w-4 h-4 flex-shrink-0 text-gray-400 dark:text-gray-500"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"></path></svg
          >
        </div>

        <!-- Employee search + year -->
        <div class="mt-2.5 flex items-center gap-2">
          <span
            class="flex-1 min-w-0 flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-gray-300 dark:border-gray-600 text-[11px] text-gray-500 dark:text-gray-400"
          >
            <svg
              class="w-3 h-3 flex-shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M20 20l-3.5-3.5"></path>
            </svg>
            Alle Mitarbeiter
            <svg
              class="w-3 h-3 ml-auto flex-shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg
            >
          </span>
          <span
            class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-gray-300 dark:border-gray-600 text-[11px] text-gray-700 dark:text-gray-300 flex-shrink-0"
          >
            2026
            <svg
              class="w-3 h-3"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg
            >
          </span>
        </div>

        <!-- Status filters -->
        <div class="mt-2 flex flex-wrap items-center gap-1.5">
          {
            filters.map((filter) => (
              <span
                class:list={[
                  'inline-flex items-center gap-1.5 px-2 py-1 rounded-lg text-[10px] font-medium',
                  filter.active
                    ? 'bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-gray-100'
                    : 'text-gray-600 dark:text-gray-400',
                ]}
              >
                {filter.label}
                <span
                  class:list={[
                    'px-1.5 rounded-full text-[9px]',
                    filter.active
                      ? 'bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300'
                      : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300',
                  ]}
                >
                  {filter.count}
                </span>
              </span>
            ))
          }
        </div>
      </div>

      <!-- Request list -->
      <div class="p-3 space-y-2.5 bg-gray-50 dark:bg-gray-900/40">
        <!-- Pending holiday request, with the two actions -->
        <div
          class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-3"
        >
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-2.5 min-w-0">
              <span
                class="w-7 h-7 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-sm flex-shrink-0"
                aria-hidden="true">🏖️</span
              >
              <div class="min-w-0">
                <p class="text-xs font-semibold text-gray-900 dark:text-gray-100 truncate">
                  Anna Schmidt
                </p>
                <p class="text-[10px] text-gray-500 dark:text-gray-400">
                  Urlaubsantrag · Eingereicht 22. Sept.
                </p>
              </div>
            </div>
            <span
              class="flex-shrink-0 px-2 py-0.5 rounded-full text-[10px] font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300"
              >Ausstehend</span
            >
          </div>

          <p class="mt-2 flex items-center gap-1.5 text-[11px] text-gray-700 dark:text-gray-300">
            <svg
              class="w-3 h-3 text-gray-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M16 3v4M8 3v4M3 11h18"></path>
            </svg>
            08.09. – 10.09.2026 · 3 Tage
          </p>
          <p class="text-[10px] text-gray-500 dark:text-gray-400 italic mt-0.5">„Familienbesuch“</p>

          <div class="mt-2.5 flex items-center justify-end gap-2">
            <span
              class="px-3 py-1 rounded-lg border border-gray-300 dark:border-gray-600 text-[11px] font-medium text-gray-700 dark:text-gray-300"
              >Ablehnen</span
            >
            <span class="px-3 py-1 rounded-lg bg-green-600 text-white text-[11px] font-medium"
              >Genehmigen</span
            >
          </div>
        </div>

        <!-- Approved time-entry request, with the change table -->
        <div
          class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-3"
        >
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-2.5 min-w-0">
              <span
                class="w-7 h-7 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-sm flex-shrink-0"
                aria-hidden="true">⏰</span
              >
              <div class="min-w-0">
                <p class="text-xs font-semibold text-gray-900 dark:text-gray-100 truncate">
                  Tim Becker
                </p>
                <p class="text-[10px] text-gray-500 dark:text-gray-400">
                  Zeiteintragsantrag · Eingereicht 24. Sept.
                </p>
              </div>
            </div>
            <span
              class="flex-shrink-0 px-2 py-0.5 rounded-full text-[10px] font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300"
              >Genehmigt</span
            >
          </div>

          <p class="mt-2 flex items-center gap-1.5 text-[11px] text-gray-700 dark:text-gray-300">
            <svg
              class="w-3 h-3 text-gray-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M16 3v4M8 3v4M3 11h18"></path>
            </svg>
            24.09.2026
          </p>

          <div
            class="mt-1.5 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden text-[10px]"
          >
            <div
              class="grid grid-cols-[1fr_0.8fr_1.3fr] bg-gray-50 dark:bg-gray-700 text-gray-500 dark:text-gray-400"
            >
              <span class="px-2 py-1">Feld</span>
              <span class="px-2 py-1">Aktuell</span>
              <span class="px-2 py-1">Angefragt</span>
            </div>
            <div
              class="grid grid-cols-[1fr_0.8fr_1.3fr] border-t border-gray-200 dark:border-gray-700"
            >
              <span class="px-2 py-1 text-gray-700 dark:text-gray-300">Zeitslot 1</span>
              <span class="px-2 py-1 text-gray-500 dark:text-gray-400">—</span>
              <span class="px-2 py-1 font-mono text-blue-600 dark:text-blue-400"
                >09:00 – 18:30 (30min)</span
              >
            </div>
            <div
              class="grid grid-cols-[1fr_0.8fr_1.3fr] border-t border-gray-200 dark:border-gray-700"
            >
              <span class="px-2 py-1 text-gray-700 dark:text-gray-300">Gesamtstunden</span>
              <span class="px-2 py-1 text-gray-500 dark:text-gray-400">0 Std</span>
              <span class="px-2 py-1 font-mono text-blue-600 dark:text-blue-400">9 Std</span>
            </div>
          </div>
          <p class="mt-1 text-center text-[10px] text-gray-600 dark:text-gray-400">
            Nettoänderung: <span class="text-green-600 dark:text-green-400">+9h (0h → 9h)</span>
          </p>

          <div class="mt-2 rounded-lg bg-gray-50 dark:bg-gray-700/60 px-2.5 py-1.5">
            <p class="text-[9px] uppercase tracking-wide text-gray-500 dark:text-gray-400">Grund</p>
            <p class="text-[11px] text-gray-800 dark:text-gray-200">Kundentermin war länger</p>
          </div>
        </div>
      </div>

      <!-- Pagination -->
      <div
        class="px-4 py-2.5 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between text-[11px] text-gray-500 dark:text-gray-400"
      >
        <span>Zeige 1–4 von 28</span>
        <span class="flex items-center gap-2">
          <svg
            class="w-3 h-3"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"><path d="M15 19l-7-7 7-7"></path></svg
          >
          Seite 1 von 7
          <svg
            class="w-3 h-3"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg
          >
        </span>
      </div>
    </div>
  </div>
</div>
